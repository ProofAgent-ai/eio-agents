{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eio-agents:schema:bundle:3.0.0",
  "title": "EIO-Agents evaluation bundle 3.0.0 (archive schema 3)",
  "description": "The input of eio_agents.convert (bundle format 3.0.0, released with EIO-Agents 0.8.0): source declarations and decisions of one evaluation run. Native proof citations bind claim, role, locator and anchor; producer numeric scores are not accepted. Views (coverage, findings, controls, scores, gates, release) are never in the bundle. Each section is owned by a stage record; producer_declared is adapter-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["archive_schema", "bundle_version", "header", "provenance", "sources", "scope", "context_assessment", "graph",
               "claims", "ballots", "trials", "stage_records", "limitations"],
  "properties": {
    "archive_schema": {"const": 3},
    "bundle_version": {"const": "3.0.0"},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_id_source", "eio_agents", "eio", "adapter", "crosswalk", "source_archive", "producer_eio",
                   "plan_hash", "seed"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "run_id_source": {"type": "string", "minLength": 1},
        "eio_agents": {"type": "object", "additionalProperties": false, "required": ["version", "ontology_sha256"],
                       "properties": {"version": {"type": "string"}, "ontology_sha256": {"$ref": "#/$defs/sha256"}}},
        "eio": {"type": "object", "additionalProperties": false, "required": ["release", "ontology_digest", "ontology_sha256"],
                "properties": {"release": {"type": "string"}, "ontology_digest": {"type": "string"},
                               "ontology_sha256": {"$ref": "#/$defs/sha256"}}},
        "adapter": {"oneOf": [{"type": "null"},
                              {"type": "object", "additionalProperties": false, "required": ["name", "version"],
                               "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}]},
        "crosswalk": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/declared_document"}]},
        "source_archive": {"oneOf": [{"type": "null"},
                                     {"type": "object", "additionalProperties": false, "required": ["archive_schema", "archive_sha256"],
                                      "properties": {"archive_schema": {"type": "integer"}, "archive_sha256": {"$ref": "#/$defs/sha256"}}}]},
        "producer_eio": {"oneOf": [{"type": "null"},
                                   {"type": "object", "additionalProperties": false, "required": ["release", "ontology_digest"],
                                    "properties": {"release": {"type": ["string", "null"]}, "ontology_digest": {"type": "string"}}}]},
        "plan_hash": {"$ref": "#/$defs/sha256"},
        "seed": {},
        "adjudication_source": {"type": ["string", "null"], "description": "optional rc1 header field of an adapter, passed through (an adapter extension at L5a)"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "record", "capsule", "agent", "telemetry"],
      "properties": {
        "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version", "kind", "revision"],
                     "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]},
                                    "kind": {"enum": ["native", "adapter"]}, "revision": {"type": ["string", "null"]}}},
        "record": {"type": "object", "additionalProperties": false, "required": ["run", "producer", "inputs"],
                   "description": "the rc1 PER provenance values the producer declares (their names change at L5a); the PER capsule is projected, not declared",
                   "properties": {"run": {"type": "object", "required": ["run_id", "started_at", "completed_at", "plan_hash"]},
                                  "producer": {"type": "object"}, "harness_llm": {"type": "object"}, "inputs": {"type": "object"}}},
        "capsule": {"type": "object", "additionalProperties": false, "required": ["present", "reproducible_declared", "caveats", "lock_digest"],
                    "properties": {"present": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                                   "reproducible_declared": {}, "caveats": {"type": "array"}, "lock_digest": {"type": ["string", "null"]}}},
        "agent": {"type": "object", "required": ["agent_id", "version", "model"]},
        "telemetry": {"type": "object"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_source_ref", "calls_field", "transcript_sha256", "archive_pointer", "turns", "context_artifacts",
                   "context_texts", "completeness"],
      "properties": {
        "turn_source_ref": {"type": "string", "minLength": 1},
        "calls_field": {"type": "string", "minLength": 1},
        "state_field": {"type": "string", "minLength": 1, "description": "the name of the turns' state snapshots (turns[].state), which STATE_FACT refs over the state ledger read (L2 exit D-34); required when a turn carries one"},
        "transcript_sha256": {"$ref": "#/$defs/sha256"},
        "archive_pointer": {"type": "object", "description": "where the turns live in the archive; the projector writes archive_sha256 (the record's archive digest)"},
        "turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}},
        "context_artifacts": {"type": "array", "items": {"$ref": "#/$defs/context_artifact"}},
        "context_texts": {"type": "object", "additionalProperties": {"type": "string"}},
        "completeness": {"type": "object", "additionalProperties": false,
                         "required": ["tool_outputs", "retrieval_text", "reliability_pass_transcripts"],
                         "properties": {"tool_outputs": {"$ref": "#/$defs/captured"}, "retrieval_text": {"$ref": "#/$defs/captured"},
                                        "sentinel_locations": {"$ref": "#/$defs/captured"}, "code_check_offsets": {"$ref": "#/$defs/captured"},
                                        "reliability_pass_transcripts": {"enum": ["CAPTURED", "NOT_CAPTURED", "NOT_APPLICABLE"]}}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_candidates", "domain_tokens", "tier", "tier_source", "autonomy", "region", "facts", "frameworks", "policy"],
      "properties": {
        "domain_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "source", "matched"],
                                                          "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "matched": {}}}},
        "domain_tokens": {"type": "array", "items": {"type": "string"}},
        "tier": {"type": ["string", "null"]},
        "tier_source": {"type": ["string", "null"]},
        "autonomy": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]},
        "facts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["value", "source"],
                                                             "properties": {"value": {"type": ["boolean", "null"]}, "source": {"type": "string"}}}},
        "frameworks": {"type": "object", "additionalProperties": false, "required": ["rule", "candidates", "personal_data"],
                       "properties": {"rule": {"enum": ["selection", "assessed"]}, "personal_data": {"type": "boolean"},
                                      "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                                "required": ["id", "basis"],
                                                                                "properties": {"id": {"type": "string"}, "basis": {"type": "string"}}}}}},
        "policy": {"$ref": "#/$defs/policy"}
      }
    },
    "context_assessment": {
      "description": "C-ctx: null when the producer ran no context assessment",
      "oneOf": [{"type": "null"},
                {"type": "object", "additionalProperties": false, "required": ["gaps"],
                 "properties": {"gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                     "required": ["criterion", "control", "files_searched", "chars_searched", "terms"],
                                                                     "properties": {"criterion": {"type": "string"}, "control": {"type": "string"},
                                                                                    "files_searched": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                                                                                    "chars_searched": {"type": "integer"},
                                                                                    "terms": {"type": "array", "items": {"type": "string"}}}}}}}]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refs", "episodes"],
      "properties": {
        "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "episodes": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}, "minItems": 1}}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "ballots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pooled_claims", "ballots"],
      "properties": {
        "pooled_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "ballots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "persona", "round", "observed"],
                                                "properties": {"claim_id": {"type": "string"}, "persona": {"type": "string"},
                                                               "round": {"type": "integer"}, "observed": {"type": ["boolean", "null"]}}}}
      }
    },
    "trials": {
      "oneOf": [{"type": "null"},
                {"type": "object", "additionalProperties": false, "required": ["trial_kind", "passes", "k", "tasks", "rate", "records", "named_lists"],
                 "properties": {"trial_kind": {"type": "string"}, "passes": {"type": "integer", "minimum": 1}, "k": {"type": "integer"},
                                "tasks": {"type": "integer"},
                                "rate": {"type": "object", "additionalProperties": false, "required": ["pass_1", "pass_k", "pass_1_se", "pass_k_se"],
                                         "properties": {"pass_1": {"type": ["number", "null"]}, "pass_k": {"type": ["number", "null"]},
                                                        "pass_1_se": {"type": ["number", "null"]}, "pass_k_se": {"type": ["number", "null"]}}},
                                "records": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                        "required": ["claim_id", "ledger_key", "trial_kind", "reproduced_in", "passes", "may_auto_block"],
                                                                        "properties": {"claim_id": {"type": "string"}, "ledger_key": {"type": ["string", "null"]},
                                                                                       "trial_kind": {"type": "string"}, "reproduced_in": {"type": "integer"},
                                                                                       "passes": {"type": "integer"}, "may_auto_block": {"type": "boolean"}}}},
                                "named_lists": {"type": ["object", "null"]}}}]
    },
    "stage_records": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["stage", "producer", "sections", "output_sha256"],
                "properties": {"stage": {"type": "string", "minLength": 1}, "producer": {"enum": ["native", "adapter"]},
                               "sections": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                               "output_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    "limitations": {
      "description": "producer disclosures, by catalogue id, rendered by the projector",
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "params"],
                "properties": {"id": {"type": "string"}, "path": {"type": ["string", "null"]}, "params": {"type": "object"}}}
    },
    "native_scoring": {
      "description": "Native-only source declarations for rederivable scoring. This is not a score or an adapter score_inputs section.",
      "type": "object", "additionalProperties": false,
      "required": ["scenario_bindings", "claim_bindings", "applicable_controls", "context_ratings"],
      "properties": {
        "scenario_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["binding_id", "turn_indices", "severity"],
          "properties": {"binding_id": {"type": "string", "minLength": 1},
            "turn_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
            "severity": {"enum": [null, "CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]}}}},
        "claim_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["claim_id", "binding_id"],
          "properties": {"claim_id": {"type": "string", "minLength": 1}, "binding_id": {"type": "string", "minLength": 1},
            "severity": false}}},
        "applicable_controls": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["framework", "control_id"],
          "properties": {"framework": {"type": "string", "minLength": 1}, "control_id": {"type": "string", "minLength": 1}}}},
        "context_ratings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["criterion_id", "artifact_name", "artifact_sha256", "assessor_id", "rating"],
          "properties": {"criterion_id": {"type": "string", "minLength": 1},
            "artifact_name": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "assessor_id": {"type": "string", "minLength": 1}, "rating": {"type": "number", "minimum": 0, "maximum": 100}}}},
        "proof_citations": {"description": "Experimental native resolution citation declarations, not inferred from a ref's anchor. Absence withholds reportability and decisiveness.",
          "type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["claim_id", "ref_id", "role", "citation_anchor", "locator_sha256"],
          "properties": {"claim_id": {"type": "string", "minLength": 1},
            "ref_id": {"type": "string", "minLength": 1}, "role": {"const": "proof"},
            "citation_anchor": {"type": "string", "minLength": 1},
            "locator_sha256": {"$ref": "#/$defs/sha256"}}}}
      }
    },
    "producer_declared": {
      "description": "Adapter-only declared inputs (split plan §4.4), each with its deletion step. Accepted only when every matching stage record says producer adapter, provenance.producer.kind is adapter and header.crosswalk is declared.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "scenarios": {"description": "scenario labels and scenario severity (until S7)", "type": "object", "additionalProperties": false,
                      "required": ["turns", "severity"],
                      "properties": {"turns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["turn_index", "label"],
                                                                           "properties": {"turn_index": {"type": "integer"}, "label": {"type": "string"}}}},
                                     "severity": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}}},
        "capabilities": {"description": "the producer capability registry, N2 (until S4)", "type": "object", "additionalProperties": false,
                         "required": ["reachable_predicates", "not_implemented_predicates"],
                         "properties": {"reachable_predicates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                                        "not_implemented_predicates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
        "context_links": {"description": "the resolved context-link rows (until S5)", "type": "object", "additionalProperties": false,
                          "required": ["claims", "rows"],
                          "properties": {"claims": {"type": "object", "additionalProperties": {"type": "string"}},
                                         "rows": {"type": "object", "additionalProperties": {"type": "array", "items": {
                                             "type": "object", "additionalProperties": false, "required": ["criterion", "control", "strength", "via"],
                                             "properties": {"criterion": {"type": "string"}, "control": {"type": "string"},
                                                            "strength": {"type": ["string", "null"]}, "via": {"type": "string"}}}}}}},
        "score_inputs": {"$ref": "#/$defs/score_inputs"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "captured": {"enum": ["CAPTURED", "NOT_CAPTURED"]},
    "declared_document": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"],
                          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "turn": {"type": "object", "additionalProperties": false, "required": ["turn_index", "question", "answer", "tool_calls", "retrievals"],
             "properties": {"turn_index": {"type": "integer"}, "question": {"type": "string"}, "answer": {"type": "string"},
                            "tool_calls": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                       "required": ["name", "arguments", "arguments_pointer"],
                                                                       "properties": {"name": {"type": "string"}, "arguments": {},
                                                                                      "arguments_pointer": {"type": "string"}, "result": {}}}},
                            "retrievals": {"type": "array", "items": {"type": "object", "required": ["source"]}},
                            "state": {"description": "the turn's state-ledger snapshot (any JSON value; given only when not empty), named by sources.state_field (L2 exit D-34)"}}},
    "context_artifact": {"type": "object", "additionalProperties": false,
                         "required": ["artifact_kind", "name", "sha256", "code_points", "embedded", "data_class"],
                         "properties": {"artifact_kind": {"type": "string"}, "name": {"type": "string"}, "sha256": {"type": "string"},
                                        "code_points": {"type": "integer"}, "embedded": {"type": "boolean"}, "data_class": {"type": "string"}}},
    "ref": {"type": "object", "required": ["id", "kind", "source_type", "can_prove_agent_behaviour", "anchor", "turn_index", "char_start",
                                           "char_end", "span_sha256", "source_ref", "source_sha256"],
            "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string"}, "source_type": {"type": "string"},
                           "can_prove_agent_behaviour": {"type": "boolean"}, "anchor": {"type": "string"},
                           "turn_index": {"type": ["integer", "null"]}, "char_start": {"type": ["integer", "null"]},
                           "char_end": {"type": ["integer", "null"]},
                           "span_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
                           "source_ref": {"type": "string", "minLength": 1},
                           "source_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
                           "tool": {"$ref": "#/$defs/tool_receipt"},
                           "statement": {"type": "object", "required": ["inputs", "output"],
                                         "properties": {"inputs": {"type": "object"}, "formula": {"type": "string"}}}},
            "allOf": [{"if": {"properties": {"kind": {"const": "TOOL_RECEIPT"}}, "required": ["kind"]}, "then": {"required": ["tool"]}},
                      {"if": {"properties": {"kind": {"const": "TYPED_ABSENCE"}}, "required": ["kind"]}, "then": {"required": ["statement"]}}]},
    "tool_receipt": {"description": "the receipt of one tool call: its name, its position in the turn's tool calls, the digest of its arguments, where they are, and the digest of its result or NOT_CAPTURED",
                     "type": "object", "additionalProperties": false,
                     "required": ["name", "call_index", "arguments_sha256", "arguments_pointer", "output"],
                     "properties": {"name": {"type": "string", "minLength": 1}, "call_index": {"type": "integer", "minimum": 0},
                                    "arguments_sha256": {"$ref": "#/$defs/sha256"}, "arguments_pointer": {"type": "string", "minLength": 1},
                                    "output": {"oneOf": [{"const": "NOT_CAPTURED"},
                                                         {"type": "object", "additionalProperties": false, "required": ["sha256"],
                                                          "properties": {"sha256": {"$ref": "#/$defs/sha256"}}}]}}},
    "claim": {"type": "object", "additionalProperties": false,
              "required": ["id", "run_id", "turn_indices", "predicate", "predicate_version", "state", "parameters", "evidence", "decided_by", "provenance"],
              "properties": {"id": {"type": "string"}, "run_id": {"type": "string"},
                             "turn_indices": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
                             "predicate": {"type": "string"}, "predicate_version": {"type": "string"}, "state": {"type": "string"},
                             "parameters": {"type": "object", "required": ["fidelity"],
                                            "properties": {"fidelity": {"enum": ["exact", "narrower"]},
                                                           "votes": {"description": "the pooled ballot counts of a pooled claim, recounted from ballots; null otherwise",
                                                                     "oneOf": [{"type": "null"},
                                                                               {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}]}},
                                            "not": {"required": ["contract_check"]}},
                             "evidence": {"type": "array", "items": {"type": "string"}},
                             "decided_by": {"enum": ["deterministic", "semantic", "human"]},
                             "resolver": {"type": "string"}, "risk": {}, "provenance": {"type": "object"}}},
    "policy": {"type": "object", "additionalProperties": false,
               "required": ["source", "origin", "profile_sha256", "name", "declared", "prohibited", "rules"],
               "properties": {"source": {"type": "string"}, "origin": {"type": ["string", "null"]}, "profile_sha256": {"type": ["string", "null"]},
                              "name": {"type": ["string", "null"]}, "declared": {}, "prohibited": {"type": "boolean"},
                              "rules": {"oneOf": [{"type": "null"},
                                                  {"type": "object", "additionalProperties": false, "required": ["min_score", "block_severity", "signoff_required"],
                                                   "properties": {"min_score": {"type": ["number", "null"]}, "block_severity": {"type": "string"},
                                                                  "signoff_required": {"type": "boolean"}}}]}}},
    "score_inputs": {
      "description": "the generic score-input section {axis, value, components [{id, value}]} of a scoring profile (the attested harness-2.x until S1b exit). The profile travels with its document (an attested document is digest-checked by EIO-Agents; a rederivable one is the registry's), and every profile number (epsilon, readiness ceiling, axis weights, band ramp, method, published metric set, G component ids) is read from the document (L4)",
      "type": "object", "additionalProperties": false, "required": ["profile", "attribution", "metrics", "axes", "readiness"],
      "properties": {
        "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version", "verifiability", "sha256", "document"],
                    "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "verifiability": {"enum": ["attested", "rederivable"]},
                                   "sha256": {"$ref": "#/$defs/sha256"}, "document": {"type": ["object", "null"]}}},
        "attribution": {"type": "boolean"},
        "metrics": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                "required": ["id", "label", "value", "confidence", "members", "pre_cap", "via_cap",
                                                             "contributions", "not_evaluated_reason"],
                                                "properties": {"id": {"type": "string"}, "legacy_metric": {"type": ["string", "null"]},
                                                               "label": {"type": ["string", "null"]}, "value": {"type": ["number", "null"]},
                                                               "confidence": {"type": ["number", "null"]},
                                                               "members": {"type": "array", "items": {"type": "string"}},
                                                               "pre_cap": {"type": ["number", "null"]}, "via_cap": {"type": ["number", "null"]},
                                                               "contributions": {"oneOf": [{"type": "null"}, {"type": "array", "items": {
                                                                   "type": "array", "prefixItems": [{"type": "string"}, {"type": "number"}], "minItems": 2, "maxItems": 2}}]},
                                                               "not_evaluated_reason": {"type": ["string", "null"]}}}},
        "axes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                             "required": ["axis", "value", "components", "explanation", "context_criteria"],
                                             "properties": {"axis": {"type": "string"}, "value": {"type": ["number", "null"]},
                                                            "components": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                                                                        "required": ["id", "value"],
                                                                                                        "properties": {"id": {"type": "string"}, "value": {"type": ["number", "null"]}}}},
                                                            "explanation": {"type": "object", "additionalProperties": false, "required": ["template_id", "params"],
                                                                            "properties": {"template_id": {"type": "string"}, "params": {"type": "object"}}},
                                                            "context_criteria": {"type": "array", "items": {"type": "string"}}}}},
        "readiness": {"type": "object", "additionalProperties": false,
                      "required": ["blocked", "margin", "interval", "cap_claims", "triggers"],
                      "properties": {"blocked": {"type": "boolean"},
                                     "margin": {"type": ["number", "null"]}, "interval": {"type": ["array", "null"], "items": {"type": "number"}},
                                     "cap_claims": {"type": "array", "items": {"type": "string"}},
                                     "triggers": {"type": "array", "items": {"type": "string"}}}}
      }
    }
  }
}
